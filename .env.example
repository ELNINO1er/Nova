API_PORT=4001
WEB_ORIGIN=http://localhost:5174
# Laissez vide en production mono-domaine; le frontend utilisera /api.
VITE_API_BASE_URL=http://localhost:4001/api
# Carte « Aide & Support » de la barre latérale (masquée si rien n'est renseigné).
# WhatsApp au format international sans + (ex. 2250700000000), ou un email.
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_HOURS=

DB_HOST=127.0.0.1
DB_PORT=3306
# Port exposé sur la machine par Docker (3308 évite le port MySQL de WAMP).
DB_HOST_PORT=3308
DB_USER=nova_app
DB_PASSWORD=change-me-to-a-strong-app-database-password
DB_ROOT_PASSWORD=change-me-to-a-distinct-root-password
DB_NAME=nova

JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# Production : nom de domaine servi en HTTPS par Caddy (docker-compose), ex. nova.mondomaine.ci.
# WEB_ORIGIN doit alors valoir https://<DOMAIN> et COOKIE_SECURE=true.
DOMAIN=
BACKUP_RETENTION_DAYS=14

# Connexion : numéro + mot de passe (patients, pharmaciens, admins, gouverneurs),
# email + mot de passe + Authenticator (médecins). Comptes créés par l'admin ;
# patients créés par leur médecin. Premier admin : npm run create:admin.
# SEED_DEMO=true insère les comptes de démonstration. Ne pas l'activer sur un pilote réel.
SEED_DEMO=false
# Mot de passe des comptes démo patient/pharmacien/admin/gouverneur (requis si SEED_DEMO=true en production).
DEMO_PASSWORD=
# Uniquement pour un pilote privé exécuté avec NODE_ENV=production.
# Ne jamais activer sur une URL publique.
ALLOW_INSECURE_DEMO=false
ENABLE_API_DOCS=false
DEMO_DOCTOR_PASSWORD=Nova-Demo-2026!
MFA_ENCRYPTION_KEY=change-me-to-a-distinct-random-secret-at-least-32-characters
COOKIE_SECURE=false

# Connexion par code SMS : désactivée par défaut (remplacée par le mot de passe).
# Pour la réactiver plus tard : OTP_LOGIN_ENABLED=true et SMS_PROVIDER=twilio|webhook.
#   demo = aucun SMS envoyé, le code s'affiche à l'écran : jamais sur un site accessible au public.
OTP_LOGIN_ENABLED=false
SMS_PROVIDER=

# Requis si SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Requis si SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Utilise uniquement par: npm run create:admin
ADMIN_PHONE=
ADMIN_NAME=Administrateur NOVA
