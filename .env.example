API_PORT=4001
WEB_ORIGIN=http://localhost:5174
# Laissez vide en production mono-domaine; le frontend utilisera /api.
VITE_API_BASE_URL=http://localhost:4001/api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sika_sante

JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# SEED_DEMO=true insère les comptes de démonstration (médecin/pharmacien/admin/patient).
# À activer pour une validation, y compris en production. Idempotent.
SEED_DEMO=false
COOKIE_SECURE=false

# SMS_PROVIDER: twilio | webhook | demo
#   demo = aucun SMS envoyé, le code OTP s'affiche directement à l'écran de connexion.
#          Idéal pour valider avec des médecins sans passerelle SMS. Ne PAS utiliser en public réel.
SMS_PROVIDER=

# Requis si SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Requis si SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Utilise uniquement par: npm run create:admin
ADMIN_PHONE=
ADMIN_NAME=Administrateur NOVA
